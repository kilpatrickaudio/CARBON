#include <assert.h>
#include <stdio.h>
#include <string.h>
#include "../src/gui/step_edit.c"
static struct track_event events[SEQ_TRACK_POLY];
static struct midi_msg output[32];
static int count, running;
static int bias_targets[SEQ_NUM_TRACKS] = {-1,-1,-1,-1,-1,-1};
static int target_lengths[SEQ_NUM_TRACKS] = {64,64,64,64,64,64};
static int current_scene;
int song_get_bias_track(int scene, int track) { return bias_targets[track]; }
int song_get_motion_length(int scene, int track) { return 64; }
int seq_engine_get_current_scene(void) { return current_scene; }
int seq_engine_get_effective_motion_length(int track) { return target_lengths[track]; }
static char rows[4][64];
int seq_ctrl_get_run_state(void) { return running; }
int seq_ctrl_get_scene(void) { return 0; }
int seq_ctrl_get_first_track(void) { return 0; }
void panel_menu_set_mode(int mode) {}
void gui_grid_clear_overlay(void) {}
void gui_grid_set_overlay_enable(int enable) {}
void gui_grid_set_overlay_color(int step, int color) {}
void gui_set_status_override(int enable) {}
int panel_menu_get_timeout(void) { return 100; }
int song_get_step_length(int scene, int track) { return 0; }
int song_get_ratchet_mode(int scene, int track, int step) { return 1; }
int song_get_start_delay(int scene, int track, int step) { return 0; }
void song_set_start_delay(int scene, int track, int step, int delay) {}
int song_get_num_step_events(int scene, int track, int step) {
    int i, n = 0; for(i = 0; i < SEQ_TRACK_POLY; i ++) n += !!events[i].type;
    return n;
}
int song_get_step_event(int scene, int track, int step, int slot, struct track_event *e) {
    *e = events[slot]; return e->type ? 0 : -1;
}
int song_set_step_event(int scene, int track, int step, int slot, struct track_event *e) {
    events[slot] = *e; return 0;
}
void gui_clear_status_text_all(void) { memset(rows, ' ', sizeof(rows)); }
void gui_set_status_text(int row, char *s) {
    assert(strlen(s) <= 28); snprintf(rows[row], sizeof(rows[row]), "%s", s);
}
void gui_set_status_text_part(int row, int pos, int width, char *s) {
    int len = strlen(s); assert(len <= width);
    memset(rows[row] + pos, ' ', width); memcpy(rows[row] + pos, s, len);
}
void gui_set_status_highlight_part(int row, int pos, int width, int mode) {}
void outproc_deliver_msg(int scene, int track, struct midi_msg *msg, int deliver, int mode) {
    assert(count < 32); output[count ++] = *msg;
}
void log_error(char *fmt, ...) { assert(!"unexpected error"); }
void log_warn(char *fmt, ...) { assert(!"unexpected warning"); }
static void setup(void) {
    int i; memset(&sedits, 0, sizeof(sedits));
    memset(events, 0, sizeof(events)); count = running = 0;
    for(i = 0; i < SEQ_TRACK_POLY; i ++) sedits.playing_notes[i] = -1;
}
int main(void) {
    int i;
    static const uint8_t types[] = {SONG_EVENT_NOTE, SONG_EVENT_CC,
        SONG_EVENT_INTERNAL_CC, SONG_EVENT_PROGCHG, SONG_EVENT_PROBABILITY,
        SONG_EVENT_EUCLIDEAN, SONG_EVENT_PRE, SONG_EVENT_NON_PRE, SONG_EVENT_HARMONY};
    {
        char label[16];
        assert(SEQ_UTILS_CLOCK_24PPQ == 8);
        assert(seq_utils_clock_pqq_to_divisor(SEQ_UTILS_CLOCK_24PPQ) == 4);
        assert(seq_utils_clock_pqq_to_divisor(SEQ_UTILS_CLOCK_16PPQ) == 6);
        panel_utils_clock_ppq_to_str(label, SEQ_UTILS_CLOCK_16PPQ);
        assert(!strcmp(label, "16 PPQ"));
    }
    setup(); events[0].type = SONG_EVENT_NOTE;
    for(i = 1; i <= 9; i ++) {
        step_edit_adjust_note(1, 1);
        assert(events[0].type == types[i % 9]);
    }
    for(i = 8; i >= 0; i --) {
        step_edit_adjust_note(-1, 1); assert(events[0].type == types[i]);
    }
    events[0] = (struct track_event){.type = SONG_EVENT_PROBABILITY, .data0 = 50};
    step_edit_adjust_note(100, 0); assert(events[0].data0 == 100);
    assert(!memcmp(rows[2] + 3, "100%", 4));
    step_edit_adjust_note(-200, 0); assert(events[0].data0 == 0);
    events[0] = (struct track_event){.type = SONG_EVENT_EUCLIDEAN, .data0 = 27, .data1 = 7};
    step_edit_adjust_note(-27, 0);
    assert(events[0].data0 == 0 && events[0].data1 == 1);
    assert(!memcmp(rows[2] + 3, "1:2", 3));
    step_edit_adjust_velocity(100, 0); assert(events[0].data1 == 1);
    step_edit_adjust_velocity(-100, 0); assert(events[0].data1 == 0);
    events[0].data0 = 27;
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 1);
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 2);
    step_edit_adjust_velocity(-1, 0); assert(events[0].data1 == 1);
    // Preview deliberately ignores false and true gates, but not normal MIDI.
    setup();
    events[0] = (struct track_event){.type = SONG_EVENT_PROBABILITY, .data0 = 0};
    events[1] = (struct track_event){.type = SONG_EVENT_NOTE, .data0 = 60, .data1 = 100, .length = 1};
    events[2] = (struct track_event){.type = SONG_EVENT_PRE};
    events[3] = (struct track_event){.type = SONG_EVENT_CC, .data0 = 7, .data1 = 99};
    events[4] = (struct track_event){.type = SONG_EVENT_NON_PRE};
    events[5] = (struct track_event){.type = SONG_EVENT_PROGCHG, .data0 = 11};
    step_edit_play_step();
    assert(count == 3 && output[0].status == MIDI_NOTE_ON);
    assert(output[1].status == MIDI_CONTROL_CHANGE && output[2].status == MIDI_PROGRAM_CHANGE);
    step_edit_run(1); assert(count == 4 && output[3].status == MIDI_NOTE_OFF);
    running = 1; step_edit_play_step(); assert(count == 4);
    step_edit_update_display(); assert(count == 4);
    setup(); sedits.enable = 1; sedits.event_pos = -1;
    events[0] = (struct track_event){.type = SONG_EVENT_INTERNAL_CC, .data0 = 16, .data1 = 64};
    step_edit_adjust_cursor(1, 1);
    assert(!strcmp(rows[0], "CCi 16: Step length"));
    for(int cc = 16; cc <= 29; cc++) {
        char expected[64];
        events[0].data0 = cc; step_edit_adjust_note(0, 0);
        snprintf(expected, sizeof(expected), "CCi %d: %s", cc, step_edit_cci_name(cc));
        assert(!strcmp(rows[0], expected));
        assert(sedits.cci_hint_timeout == 2000 && !count);
    }
    sedits.edit_timeout = 10000;
    for(int tick = 0; tick < 1999; tick++) step_edit_timer_task();
    assert(!strcmp(rows[0], "CCi 29: Euclidean rotation"));
    char lower[3][64]; memcpy(lower, rows + 1, sizeof(lower));
    step_edit_timer_task();
    assert(!strcmp(rows[0], "Edit - Track:  1 Step:  1"));
    assert(!memcmp(lower, rows + 1, sizeof(lower)) && !count);
    step_edit_adjust_note(-1, 0); assert(!strcmp(rows[0], "CCi 28: Euclidean density"));
    step_edit_adjust_cursor(1, 1);
    assert(!sedits.cci_hint_timeout && !strcmp(rows[0], "Edit - Track:  1 Step:  1"));
    assert(!step_edit_cci_name(15) && !step_edit_cci_name(30));
    for(int cc = 16; cc <= 29; cc++)
        for(int raw = 0; raw <= 127; raw++) {
            char decoded[64]; step_edit_cci_value_title(decoded, cc, raw);
            assert(strlen(decoded) <= 28);
        }
    { char decoded[64];
      step_edit_cci_value_title(decoded, 17, 64); assert(!strcmp(decoded, "CCi 17: Transpose +0 semis"));
      step_edit_cci_value_title(decoded, 17, 0); assert(!strcmp(decoded, "CCi 17: Transpose -24 semis"));
      step_edit_cci_value_title(decoded, 18, 63); assert(!strcmp(decoded, "CCi 18: Mute Off"));
      step_edit_cci_value_title(decoded, 18, 64); assert(!strcmp(decoded, "CCi 18: Mute On"));
      step_edit_cci_value_title(decoded, 19, 127); assert(!strcmp(decoded, "CCi 19: Start 64"));
      step_edit_cci_value_title(decoded, 22, 64); assert(!strcmp(decoded, "CCi 22: Gate time 101%"));
      step_edit_cci_value_title(decoded, 27, 127); assert(!strcmp(decoded, "CCi 27: Arp gate 384 ticks"));
      step_edit_cci_value_title(decoded, 28, 127); assert(!strcmp(decoded, "CCi 28: 100% No Bias target"));
    }
    sedits.event_pos = 0; events[0] = (struct track_event){.type = SONG_EVENT_INTERNAL_CC, .data0 = 18, .data1 = 62};
    step_edit_adjust_velocity(1, 0);
    assert(events[0].data1 == 64 && !strcmp(rows[0], "CCi 18: Mute On") && !count);
    sedits.edit_timeout = 10000;
    for(int tick = 0; tick < 2000; tick++) step_edit_timer_task();
    assert(!strcmp(rows[0], "Edit - Track:  1 Step:  1"));
    // Every detent crosses exactly one distinct conversion bucket.
    for(int cc = 16; cc <= 28; cc++)
        for(int raw = 0; raw <= 127; raw++)
            for(int dir = -1; dir <= 1; dir += 2) {
                int old = midi_ctrl_internal_cc_to_value(cc, raw, 64);
                int next = step_edit_adjust_cci_value(cc, raw, dir);
                int decoded = midi_ctrl_internal_cc_to_value(cc, next, 64);
                assert(next >= 0 && next <= 127);
                int scan = raw + dir;
                while(scan >= 0 && scan <= 127 && midi_ctrl_internal_cc_to_value(cc, scan, 64) == old) scan += dir;
                if(scan < 0 || scan > 127) assert(next == raw);
                else assert(decoded == midi_ctrl_internal_cc_to_value(cc, scan, 64) && decoded != old);
            }
    assert(step_edit_adjust_cci_value(18, 0, 1) == 64);
    assert(step_edit_adjust_cci_value(18, 127, -1) == 0);
    assert(step_edit_adjust_cci_value(17, 0, 1) == 18); // -24 -> -23
    assert(step_edit_adjust_cci_value(17, 64, 1) == 66);
    assert(step_edit_adjust_cci_value(29, 64, 1) == 66);
    assert(step_edit_adjust_cci_value(29, 0, -1) == 0);
    assert(step_edit_adjust_cci_value(29, 126, 1) == 127);
    assert(step_edit_adjust_cci_value(29, 127, -1) == 125);
    for(int cc = 16; cc <= 28; cc++) {
        int raw = 0, visits = 1;
        while(step_edit_adjust_cci_value(cc, raw, 1) != raw) { raw = step_edit_adjust_cci_value(cc, raw, 1); visits++; assert(visits <= 128); }
        assert(step_edit_adjust_cci_value(cc, 0, 128) == raw);
        while(step_edit_adjust_cci_value(cc, raw, -1) != raw) raw = step_edit_adjust_cci_value(cc, raw, -1);
        assert(raw == 0);
    }
    { char text[64];
      step_edit_cci_value_title(text, 22, 127); assert(!strcmp(text, "CCi 22: Gate time 200%"));
      step_edit_cci_value_title(text, 25, 0); assert(!strcmp(text, "CCi 25: Arp type Up 1"));
      step_edit_cci_value_title(text, 25, 127); assert(!strcmp(text, "CCi 25: Arp type Random 4"));
    }
    events[0] = (struct track_event){.type = SONG_EVENT_CC, .data0 = 18, .data1 = 0};
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 2);
    events[0].type = SONG_EVENT_INTERNAL_CC; events[0].data1 = 0;
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 64);
    step_edit_adjust_velocity(-1, 0); assert(events[0].data1 == 0);
    { char title[64];
      step_edit_cci_value_title(title, 29, 127);
      assert(!strcmp(title, "CCi 29: No Bias target"));
      bias_targets[0] = 0; // self is not a receiving track
      bias_targets[1] = bias_targets[4] = 0;
      target_lengths[1] = 64; target_lengths[4] = 16;
      step_edit_cci_value_title(title, 29, 127);
      assert(!strcmp(title, "CCi 29: T2 Rot 63/64"));
      for(int len = 1; len <= 64; len++) {
          target_lengths[1] = len;
          for(int raw = 0; raw <= 127; raw++) {
              char expected[64];
              snprintf(expected, sizeof(expected), "CCi 29: T2 Rot %d/%d", (raw * len) / 128, len);
              step_edit_cci_value_title(title, 29, raw);
              assert(!strcmp(title, expected) && strlen(title) <= 28);
          }
      }
      events[0] = (struct track_event){.type = SONG_EVENT_INTERNAL_CC, .data0 = 29, .data1 = 126};
      target_lengths[1] = 64; step_edit_adjust_velocity(1, 0);
      assert(events[0].data1 == 127 && !strcmp(rows[0], "CCi 29: T2 Rot 63/64"));
      char lower[3][64]; memcpy(lower, rows + 1, sizeof(lower));
      target_lengths[1] = 16; sedits.edit_timeout = 10000;
      for(int tick = 0; tick < 100; tick++) step_edit_timer_task();
      assert(!strcmp(rows[0], "CCi 29: T2 Rot 15/16"));
      assert(!memcmp(lower, rows + 1, sizeof(lower)) && !count);
      bias_targets[1] = -1; step_edit_cci_value_title(title, 29, 127);
      assert(!strcmp(title, "CCi 29: T5 Rot 15/16"));
      current_scene = 1; step_edit_cci_value_title(title, 29, 127);
      assert(!strcmp(title, "CCi 29: T5 Rot 63/64"));
    }
    { char title[64];
      current_scene = 0; bias_targets[1] = 0;
      for(int len = 1; len <= 64; len++) {
          target_lengths[1] = len;
          for(int raw = 0; raw < 128; raw++) {
              int percent = midi_ctrl_internal_cc_to_value(28, raw, len);
              char expected[64];
              if(percent == 100) snprintf(expected, sizeof(expected), "CCi 28: T2 100%% Pattern");
              else snprintf(expected, sizeof(expected), "CCi 28: T2 %d%% %d/%d", percent, (percent * len + 50) / 100, len);
              step_edit_cci_value_title(title, 28, raw);
              assert(!strcmp(title, expected) && strlen(title) <= 28);
          }
      }
      events[0] = (struct track_event){.type = SONG_EVENT_INTERNAL_CC, .data0 = 28, .data1 = 64};
      target_lengths[1] = 16; step_edit_adjust_velocity(0, 0);
      assert(!strcmp(rows[0], "CCi 28: T2 50% 8/16"));
      target_lengths[1] = 32; sedits.edit_timeout = 10000;
      for(int tick = 0; tick < 100; tick++) step_edit_timer_task();
      assert(!strcmp(rows[0], "CCi 28: T2 50% 16/32"));
    }
    setup(); sedits.event_pos = 0;
    events[0] = (struct track_event){.type = SONG_EVENT_HARMONY, .data0 = SCALE_MAJOR, .data1 = SONG_HARMONY_ROOT_KEEP};
    step_edit_update_display(); assert(!strcmp(rows[0], "Hrm: Major / Keep"));
    assert(!memcmp(rows[1] + 3, "Hrm", 3));
    step_edit_adjust_velocity(1, 0);
    assert(events[0].data1 == SONG_HARMONY_ROOT_OFF && !strcmp(rows[0], "Hrm: Major / Off"));
    step_edit_adjust_velocity(1, 0);
    assert(events[0].data1 == SONG_HARMONY_ROOT_C && !strcmp(rows[0], "Hrm: Major / C"));
    step_edit_adjust_velocity(100, 0); assert(events[0].data1 == SONG_HARMONY_ROOT_MAX);
    step_edit_adjust_note(100, 0); assert(events[0].data0 == 15);
    step_edit_adjust_note(-100, 0); assert(events[0].data0 == 0);
    step_edit_play_step(); assert(!count); // Hrm preview is inert
    for(int scale = 0; scale < 16; scale++)
        for(int root = 0; root <= SONG_HARMONY_ROOT_MAX; root++) {
            events[0].data0 = scale; events[0].data1 = root;
            step_edit_update_display(); assert(strlen(rows[0]) <= 28);
        }
    puts("editor tests passed"); return 0;
}
